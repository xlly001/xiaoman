<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:usesCleartextTraffic="true">
        <!-- Debug-only: allow local vLLM/Ollama endpoints over http for development and tests. -->
        <!-- Developer bridge for the xiaoman CLI (adb shell am broadcast). Debug builds only. -->
        <receiver
            android:name=".debug.DebugReceiver"
            android:exported="true"
            tools:ignore="ExportedReceiver"
            xmlns:tools="http://schemas.android.com/tools">
            <intent-filter>
                <action android:name="dev.xiaoman.debug.RUN" />
                <action android:name="dev.xiaoman.debug.STOP" />
                <action android:name="dev.xiaoman.debug.RELOAD_SKILLS" />
                <action android:name="dev.xiaoman.debug.SAY" />
                <action android:name="dev.xiaoman.debug.ENQUEUE" />
                <action android:name="dev.xiaoman.debug.QUEUE_PAUSE" />
                <action android:name="dev.xiaoman.debug.QUEUE_RESUME" />
                <action android:name="dev.xiaoman.debug.QUEUE_CANCEL" />
                <action android:name="dev.xiaoman.debug.QUEUE_STATUS" />
                <action android:name="dev.xiaoman.debug.MEDIA_ASR" />
                <action android:name="dev.xiaoman.debug.MEDIA_TTS" />
                <action android:name="dev.xiaoman.debug.MEDIA_OCR" />
                <action android:name="dev.xiaoman.debug.MEDIA_STATUS" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
